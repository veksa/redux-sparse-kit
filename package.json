{
  "name": "redux-sparse-kit",
  "version": "0.0.0",
  "description": "Dynamic reducers and epics for large Redux stores: only mounted features run on dispatch",
  "keywords": [
    "code-splitting",
    "dynamic-reducers",
    "lazy-loading",
    "performance",
    "react-redux",
    "redux",
    "redux-observable"
  ],
  "homepage": "https://github.com/veksa/redux-sparse-kit#readme",
  "bugs": {
    "url": "https://github.com/veksa/redux-sparse-kit/issues"
  },
  "license": "MIT",
  "author": "Aleksandr Khizhnyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veksa/redux-sparse-kit.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "yarn clean && tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src/",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "compile": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "redux": "^5.0.1",
    "rimraf": "^6.0.1",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "redux": "^5.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
