{
  "name": "redux-sparse-kit",
  "version": "0.1.1",
  "description": "Dynamic reducers and epics for large Redux stores: only mounted features run on dispatch",
  "keywords": [
    "code-splitting",
    "dynamic-reducers",
    "lazy-loading",
    "performance",
    "react-redux",
    "redux",
    "redux-observable"
  ],
  "homepage": "https://github.com/veksa/redux-sparse-kit#readme",
  "bugs": {
    "url": "https://github.com/veksa/redux-sparse-kit/issues"
  },
  "license": "MIT",
  "author": "Aleksandr Khizhnyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veksa/redux-sparse-kit.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "observable": [
        "./dist/observable.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./observable": {
      "import": {
        "types": "./dist/observable.d.mts",
        "default": "./dist/observable.mjs"
      },
      "require": {
        "types": "./dist/observable.d.ts",
        "default": "./dist/observable.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    }
  },
  "scripts": {
    "build": "yarn clean && tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit -p _type-tests/tsconfig.json",
    "lint": "oxlint src/",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "compile": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@veksa/react-redux": "9.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "expect-type": "^1.2.1",
    "jsdom": "^30.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-observable": "3.0.0-rc.3",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "redux": "^5.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.18.0"
}
