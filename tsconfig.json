{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "es2019",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2020"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
